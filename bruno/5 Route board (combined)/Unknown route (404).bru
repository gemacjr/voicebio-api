meta {
  name: Unknown route (404)
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/routes/NoSuchRoute/live
  body: none
  auth: inherit
}

tests {
  test("404 even though the realtime feed answered", function () {
    expect(res.status).to.equal(404);
    expect(res.body.title).to.equal("Route not found");
  });
}
