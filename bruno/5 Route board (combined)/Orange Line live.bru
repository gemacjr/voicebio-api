meta {
  name: Orange Line live
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/routes/Orange/live
  body: none
  auth: inherit
}

tests {
  test("both sources answered", function () {
    expect(res.status).to.equal(200);
    expect(res.body.sources).to.deep.equal({ v3: "OK", gtfsRealtime: "OK" });
  });

  test("realtime positions carry station names from V3", function () {
    const withStop = res.body.vehicles.filter((v) => v.stop);
    withStop.forEach((v) => expect(v.stop.name, "vehicle " + v.vehicleId).to.be.a("string"));
    console.log(res.body.route.name + ": " + res.body.vehicles.length + " vehicles, " + withStop.length + " at or heading to a station");
  });
}
